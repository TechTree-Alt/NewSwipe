<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Metro UI: 글자 크기를 바꾼 글자에 원래(설정 검색이 기대하는) 글자 크기(px)를 남겨 둔다 (ui.Metro.searchPx). -->
    <item name="metro_search_px" type="id" />
    <!-- Neumorphism: 그림자가 잘리지 않게 부모의 자르기를 끄는 리스너를 이미 붙였는지 (같은 뷰에 거듭 붙지 않게, ui.NeuUi.unclip). -->
    <item name="neu_unclip" type="id" />
    <!-- Metro UI: 아래에 항목 사이 여백을 이미 품은 줄(토글) 표시 (하위 묶음 뒤에 여백을 더할지 정한다, SettingsWidgets.subGroup). -->
    <item name="metro_gap_end" type="id" />
    <!-- 보일 때의 위·아래 바깥 여백(px, int[2]): 펼치고 접을 때 높이와 함께 0에서/으로 움직인다 (ui.Ui.setVisibleAnimated). -->
    <item name="shown_margins" type="id" />
</resources>
