<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 바 색을 투명으로 두는 까닭은 values/themes.xml 참고. -->
    <style name="Theme.NewSwipe" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#7FA6FF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/settings_background</item>
    </style>

    <style name="Theme.NewSwipe.Ime" parent="android:Theme.DeviceDefault.InputMethod">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
