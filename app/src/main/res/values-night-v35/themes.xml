<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 15부터는 창이 내비게이션 바 뒤까지 그려지면서 창의 내비게이션 바 색이 투명으로 바뀐다.
        그러면 제조사 하단 바가 배경을 어둡다고 보고 밝은 아이콘을 쓰므로, 키보드 창은 이 강제 적용에서 빠진다.
        targetSdk 36 이상(기본 빌드, Play 요건)에서는 시스템이 이 설정을 무시하고, 키보드 창은 인셋 처리(NewSwipeIME)와
        applyNavigationBarStyle로 하단 바 배경·아이콘 밝기를 맞춘다. 이 설정은 -Pnewswipe.targetSdk=35 시험 빌드에서만 효과가 있다.
    -->
    <style name="Theme.NewSwipe.Ime" parent="android:Theme.DeviceDefault.InputMethod">
        <item name="android:navigationBarColor">@color/keyboard_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
